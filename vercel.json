{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.openkrillion.com" }], "destination": "https://openkrillion.com/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    { "source": "/(.*)\\.(mjs|css|svg|png|txt)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/assets/(.*)\\.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "5 5 * * *" }
  ]
}
